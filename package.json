{
  "name": "coin-clicker",
  "private": true,
  "version": "1.8.0-rc.1",
  "description": "Coin Clicker - game cá nhân, chạy trên máy của bạn.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "node scripts/serve-local.mjs --open",
    "simulate": "tsx scripts/simulate-economy.ts",
    "benchmark": "node --expose-gc --import tsx scripts/benchmark-engine.ts",
    "audit:economy": "tsx scripts/audit-economy.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsx scripts/check-architecture.ts",
    "format": "prettier --write src scripts tests docs *.ts *.js *.json *.html README.md CHANGELOG.md",
    "format:check": "prettier --check src scripts tests docs *.ts *.js *.json *.html README.md CHANGELOG.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/validate-content.ts",
    "check": "npm run typecheck && npm run lint && npm run validate:content && npm run test && npm run format:check"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
